---
// Small print at the very end: what is a demo, what is generic, what is research.
interface Props {
  notes: string[];
}

const { notes } = Astro.props;
---

<aside class="notes">
  <ul>
    {notes.map((n) => <li set:html={n} />)}
  </ul>
</aside>

<style>
  .notes {
    width: min(100% - 2 * var(--gutter), 76rem);
    margin: 0 auto;
    padding: 2rem 0 clamp(4rem, 3rem + 4vh, 6rem);
    border-top: 1px solid var(--line);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 0.75rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    padding-left: 1.1rem;
    font-size: var(--fs-xs);
    line-height: 1.6;
    color: var(--text-3);
  }

  li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.35rem;
    height: 1px;
    background: var(--text-4);
  }
</style>
