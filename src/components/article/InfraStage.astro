---
// Infrastructure stage, one diagram in three states (SVG shapes in a 640 × 520 box, HTML labels on top):
//   infra-rules    the layer path bottom-up with a check between every two layers: what must exist before the next
//                  layer may start (rules of good practice)
//   infra-compute  compute nodes beside it — CFD, FEM, rendering, AI-assisted CFD — wired to the layers they serve
//   infra-open     the whole architecture turns to an open blueprint: "Coming soon · Open source"
// Words come from the article: labels.rules and labels.compute (its list after the colon names the nodes), and the
// infra-open step's own kicker and title.
import { LAYERS } from '../../data/article';
import type { Step } from '../../content/bottom-up/types';

interface Props {
  labels: Record<string, string>;
  /** the infra-open step (its kicker and title name the open-source state) */
  open?: Step;
  state?: string;
}

const { labels, open, state } = Astro.props;
const [computeTitle, computeList = ''] = labels.compute.split(':');
const nodes = [...computeList.split('·').map((s) => s.trim()).filter(Boolean), 'AI-assisted CFD'];
const W = 640;
const H = 520;
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;

// layer rows, bottom-up (level 1 at the bottom)
const ROW = { x: 36, w: 252, h: 42, y0: 420, step: 78 };
const rowY = (level: number) => ROW.y0 - (level - 1) * ROW.step;
const rows = LAYERS.map((l) => {
  const half = l.span !== 'full';
  const w = half ? (ROW.w - 10) / 2 : ROW.w;
  const x = l.span === 'right' ? ROW.x + w + 10 : ROW.x;
  return { ...l, x, y: rowY(l.level), w };
});
// compute nodes, right column; each shows four load bars (still, filled once on infra-compute)
const NODE = { x: 392, w: 212, h: 52, y0: 118, step: 82 };
const LOAD = [0.45, 0.8, 0.6, 0.9];
const nodeY = (i: number) => NODE.y0 + i * NODE.step;
// which layer each node serves (CFD and AI-assisted CFD: the machine; FEM: the steel; rendering: the renders)
const serves = ['mechgraph', 'plantmesh', 'architecture', 'mechgraph'];
const links = nodes.map((_, i) => {
  const row = rows.find((r) => r.id === serves[i])!;
  const x1 = NODE.x;
  const y1 = nodeY(i) + NODE.h / 2;
  const x0 = ROW.x + ROW.w;
  const y0 = row.y + ROW.h / 2;
  return `M${x1} ${y1} C${x1 - 58} ${y1} ${x0 + 58} ${y0} ${x0} ${y0}`;
});
---

<div class="infra" data-fixed-state={state} role="img" aria-label={`${labels.rules} · ${labels.compute}${open ? ` · ${open.kicker}: ${open.title}` : ''}`}>
  <svg class="infra-svg" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
    <g class="g-links" fill="none">
      {links.map((d, i) => <path class="link" d={d} style={`--k:${i}`} />)}
    </g>
    <g class="g-rows">
      {
        rows.map((r) => (
          <rect class="row" x={r.x} y={r.y} width={r.w} height={ROW.h} rx="10" style={`--lc:${r.color};--lv:${r.level}`} />
        ))
      }
    </g>
    <g class="g-gates">
      {
        [1, 2, 3, 4].map((lv) => {
          const y = rowY(lv) - (ROW.step - ROW.h) / 2;
          return (
            <g class="gate" transform={`translate(${ROW.x + ROW.w / 2} ${y})`} style={`--lv:${lv}`}>
              <path d={`M${-ROW.w / 2 + 20} 0 H${ROW.w / 2 - 20}`} class="gate-bar" />
              <circle r="11" class="gate-dot" />
              <path d="M-5 0.5 l3.4 3.4 l6.6 -7.4" class="gate-check" />
            </g>
          );
        })
      }
    </g>
    <g class="g-nodes">
      {
        nodes.map((_, i) => (
          <g class="node" transform={`translate(${NODE.x} ${nodeY(i)})`} style={`--k:${i}`}>
            <rect width={NODE.w} height={NODE.h} rx="10" class="node-box" />
            <circle cx="18" cy={NODE.h / 2} r="4" class="node-led" />
            {LOAD.map((_, b) => (
              <rect x={NODE.w - 52 + b * 10} y="14" width="5" height={NODE.h - 28} rx="1.5" class="node-bar" style={`--load:${LOAD[(b + i) % LOAD.length]}`} />
            ))}
          </g>
        ))
      }
    </g>
  </svg>

  <span class="lbl head l-rules" style={`left:${pct(ROW.x, W)};top:${pct(52, H)}`}>{labels.rules}</span>
  <span class="lbl head l-compute" style={`left:${pct(NODE.x, W)};top:${pct(52, H)}`}>{computeTitle.trim()}</span>
  {
    rows.map((r) => (
      <span class="lbl row-name" style={`left:${pct(r.x + 14, W)};top:${pct(r.y + ROW.h / 2, H)};--lc:${r.color}`}>
        {r.name}
      </span>
    ))
  }
  {
    nodes.map((n, i) => (
      <span class="lbl node-name" style={`left:${pct(NODE.x + 34, W)};top:${pct(nodeY(i) + NODE.h / 2, H)}`}>
        {n}
      </span>
    ))
  }
  {
    open && (
      <span class="lbl open-badge" style={`left:${pct(320, W)};top:${pct(260, H)}`}>
        <i aria-hidden="true">&lt;/&gt;</i>
        <small>{open.kicker}</small>
        <b>{open.title}</b>
      </span>
    )
  }
</div>

<style>
  .infra {
    --u: calc(100cqw / 640);
    position: relative;
    container-type: inline-size;
    width: min(100%, 100cqh * 640 / 520);
    aspect-ratio: 640 / 520;
    margin: auto;
  }

  .infra-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .infra-svg g,
  .infra-svg rect,
  .infra-svg path,
  .infra-svg circle {
    transition:
      opacity var(--dur) var(--ease-out),
      stroke var(--dur) var(--ease-out),
      fill var(--dur) var(--ease-out);
  }

  /* rows: the layer path, edged in each layer's colour */
  .row {
    fill: var(--bg-raised);
    stroke: color-mix(in srgb, var(--lc) 70%, transparent);
    stroke-width: 1.3;
  }

  /* gates: a check between every two layers, lit bottom-up on infra-rules */
  .gate-bar {
    stroke: var(--line-strong);
    stroke-width: 1.2;
    stroke-dasharray: 3 5;
  }

  .gate-dot {
    fill: var(--bg);
    stroke: var(--text-4);
    stroke-width: 1.3;
  }

  .gate-check {
    fill: none;
    stroke: var(--ok);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.25;
  }

  :global([data-state='infra-rules']) .gate-check,
  :global([data-state='infra-compute']) .gate-check,
  .infra[data-fixed-state='infra-rules'] .gate-check,
  .infra[data-fixed-state='infra-compute'] .gate-check {
    opacity: 1;
    transition-delay: calc(0.25s + var(--lv) * 0.28s);
  }

  :global([data-state='infra-rules']) .gate-dot,
  :global([data-state='infra-compute']) .gate-dot,
  .infra[data-fixed-state='infra-rules'] .gate-dot,
  .infra[data-fixed-state='infra-compute'] .gate-dot {
    stroke: var(--ok);
    transition-delay: calc(0.25s + var(--lv) * 0.28s);
  }

  /* compute nodes and their links */
  .g-nodes,
  .g-links,
  .node-name,
  .l-compute {
    opacity: 0;
  }

  /* compute nodes are not layers: neutral boxes, a status dot and four load bars */
  .node-box {
    fill: var(--bg-raised);
    stroke: var(--line-strong);
    stroke-width: 1.3;
  }

  .node-led {
    fill: var(--ok);
  }

  .node-bar {
    fill: var(--text-3);
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transform: scaleY(0.2);
  }

  .link {
    stroke: var(--text-4);
    stroke-width: 1.3;
    stroke-dasharray: 4 6;
  }

  :global([data-state='infra-compute']) .g-nodes,
  :global([data-state='infra-compute']) .g-links,
  :global([data-state='infra-compute']) .node-name,
  :global([data-state='infra-compute']) .l-compute,
  :global([data-state='infra-open']) .g-nodes,
  :global([data-state='infra-open']) .g-links,
  :global([data-state='infra-open']) .node-name,
  :global([data-state='infra-open']) .l-compute,
  .infra[data-fixed-state='infra-compute'] :is(.g-nodes, .g-links, .node-name, .l-compute),
  .infra[data-fixed-state='infra-open'] :is(.g-nodes, .g-links, .node-name, .l-compute) {
    opacity: 1;
  }

  /* the nodes take their load once as they come on (no running meters) */
  .infra-svg .node-bar {
    transition: transform 0.9s var(--ease-out) var(--bar-delay, 0s);
  }

  :global([data-state='infra-compute']) .node-bar,
  :global([data-state='infra-open']) .node-bar,
  .infra[data-fixed-state='infra-compute'] .node-bar,
  .infra[data-fixed-state='infra-open'] .node-bar {
    transform: scaleY(var(--load));
  }

  :global([data-state='infra-compute']) .node-bar {
    --bar-delay: calc(0.3s + var(--k, 0) * 0.12s);
  }

  /* open: the architecture becomes a blueprint, the badge takes the centre */
  :global([data-state='infra-open']) :is(.g-rows, .g-gates, .g-nodes, .g-links),
  .infra[data-fixed-state='infra-open'] :is(.g-rows, .g-gates, .g-nodes, .g-links) {
    opacity: 0.35;
  }

  :global([data-state='infra-open']) .row,
  :global([data-state='infra-open']) .node-box,
  .infra[data-fixed-state='infra-open'] :is(.row, .node-box) {
    fill: transparent;
    stroke-dasharray: 5 5;
  }

  /* labels */
  .lbl {
    position: absolute;
    translate: 0 -50%;
    font: 600 clamp(10px, calc(14 * var(--u)), 15px) / 1.2 var(--font-display);
    color: var(--text);
    white-space: nowrap;
    transition: opacity var(--dur) var(--ease-out);
    pointer-events: none;
  }

  .head {
    font-size: clamp(9px, calc(11.5 * var(--u)), 13px);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .row-name {
    color: color-mix(in oklab, var(--lc) 83%, white);
    font-size: clamp(9px, calc(13 * var(--u)), 14px);
  }

  .node-name {
    font-size: clamp(9.5px, calc(13.5 * var(--u)), 15px);
  }

  :global([data-state='infra-open']) :is(.row-name, .node-name, .head),
  .infra[data-fixed-state='infra-open'] :is(.row-name, .node-name, .head) {
    opacity: 0.35;
  }

  /* the badge is centred by its transform alone (no label translate) */
  .lbl.open-badge {
    translate: none;
  }

  /* a flat card over the faded diagram: a neutral line and a neutral shadow */
  .open-badge {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    width: calc(340 * var(--u));
    padding: calc(22 * var(--u)) calc(18 * var(--u));
    border-radius: var(--radius);
    background: var(--bg-raised);
    box-shadow:
      0 0 0 1px var(--line-strong),
      0 12px 32px -18px rgb(0 0 0 / 0.6);
    text-align: center;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.96);
    transition:
      opacity var(--dur) var(--ease-out) 0.35s,
      transform var(--dur-slow) var(--ease-out) 0.35s;
  }

  .open-badge i {
    font: 600 clamp(18px, calc(28 * var(--u)), 32px) / 1 var(--font-display);
    font-style: normal;
    color: var(--accent);
  }

  .open-badge small {
    font-size: clamp(9px, calc(11 * var(--u)), 12px);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .open-badge b {
    font-size: clamp(16px, calc(24 * var(--u)), 28px);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  :global([data-state='infra-open']) .open-badge,
  .infra[data-fixed-state='infra-open'] .open-badge {
    opacity: 1;
    transform: translate(-50%, -50%);
  }

  :global([data-calm]) .infra .node-bar,
  .infra[data-fixed-state] .node-bar {
    transition: none;
  }
</style>
