---
// ProcessView stage: one app frame (16:9), five looks keyed on the stage state —
//   pv-build      the P&ID drawn element by element (clip, plays once while on)
//   pv-selection  the valve InfoBox: CSS zoom into the top-right of the still and a highlight ring on the InfoBox
//   pv-registers  materials → pipelines → instrumentation, crossfading while on (src/scripts/article/processview.ts)
//   pv-sim        the time-lapse clip with the live batch chart beside it (SimChart)
//   pv-plc        the final frame zoomed onto the Programs panel, framed, with a "PLC · emulated" chip
import { words } from '../../data/media';
import type { Lang } from '../../i18n/config';
import MediaLayer from './MediaLayer.astro';
import SimChart from './SimChart.astro';

interface Props {
  lang: Lang;
  labels: Record<string, string>;
}

const { lang, labels } = Astro.props;
const sizes = '(min-width: 1000px) 60vw, 100vw';
// zoomed stills need the pixels of their zoom
const zoomed = (s: number) => `(min-width: 1000px) ${Math.round(60 * s)}vw, ${Math.round(100 * s)}vw`;

// InfoBox of pv-infobox-nozzles: x 0.76–0.96, y 0.02–0.47 of the still. Zoom s about the top-right corner shows the
// window x ∈ [1 − 1/s, 1], y ∈ [0, 1/s]; the ring is the InfoBox mapped into that window.
const SEL = { s: 1.8, box: { x0: 0.76, x1: 0.96, y0: 0.02, y1: 0.47 } };
const selRing = (() => {
  const { s, box } = SEL;
  const ox = 1 - 1 / s;
  const pad = 0.012;
  return {
    left: ((box.x0 - ox) * s - pad) * 100,
    top: (box.y0 * s - pad) * 100,
    width: ((box.x1 - box.x0) * s + 2 * pad) * 100,
    height: ((box.y1 - box.y0) * s + 2 * pad) * 100,
  };
})();
// Programs panel of pv-sim-final: x ≥ 0.79. Zoom s about the right-middle edge shows x ∈ [1 − 1/s, 1].
const PLC = { s: 1.4, x0: 0.79 };
const plcLeft = (PLC.x0 - (1 - 1 / PLC.s)) * PLC.s * 100;
const REGS = ['pv-tab-materials', 'pv-tab-pipelines', 'pv-tab-instrumentation'];
const caption = (id: string) => words(id, lang).caption ?? '';
const pc = (v: number) => `${v.toFixed(2)}%`;
---

<div class="pv" data-pv>
  <div class="pv-frame">
    <div class="pv-layer l-build" data-look="pv-build">
      <MediaLayer id="pv-build" lang={lang} kind="clip" loop={false} sizes={sizes} />
    </div>

    <div class="pv-layer l-select" data-look="pv-selection">
      <div class="zoom" style={`--s:${SEL.s}`}>
        <MediaLayer id="pv-infobox-nozzles" lang={lang} sizes={zoomed(SEL.s)} />
      </div>
      <div class="ring" style={`left:${pc(selRing.left)};top:${pc(selRing.top)};width:${pc(selRing.width)};height:${pc(selRing.height)}`} aria-hidden="true"></div>
    </div>

    <div class="pv-layer l-reg" data-look="pv-registers" data-registers data-reg="0">
      {
        REGS.map((id, i) => (
          <div class="reg" data-reg-item={i}>
            <MediaLayer id={id} lang={lang} sizes={zoomed(1.12)} />
          </div>
        ))
      }
    </div>

    <div class="pv-layer l-sim" data-look="pv-sim">
      <MediaLayer id="pv-sim" lang={lang} kind="clip" loop={false} sizes={sizes} />
    </div>

    <div class="pv-layer l-plc" data-look="pv-plc">
      <div class="zoom" style={`--s:${PLC.s}`}>
        <MediaLayer id="pv-sim-final" lang={lang} sizes={zoomed(PLC.s)} />
      </div>
      <div class="callout" style={`left:${pc(plcLeft)}`} aria-hidden="true"></div>
      <span class="plc-chip" style={`right:calc(${pc(100 - plcLeft)} + 0.8rem)`} aria-hidden="true"><i></i>{labels.plc}</span>
    </div>

    <div class="pv-vignette" aria-hidden="true"></div>
  </div>

  <p class="pv-caption" aria-hidden="true">
    <span data-cap="pv-build">{caption('pv-build')}</span>
    <span data-cap="pv-selection">{caption('pv-infobox-nozzles')}</span>
    {REGS.map((id, i) => <span data-cap="pv-registers" data-cap-reg={i}>{caption(id)}</span>)}
    <span data-cap="pv-sim">{caption('pv-sim')}</span>
    <span data-cap="pv-plc">{caption('pv-sim-final')}</span>
  </p>

  <div class="pv-chart">
    <SimChart labels={labels} lang={lang} />
  </div>
</div>

<style>
  .pv {
    /* frame width and height; the batch chart takes --ch under it and the pair centres while it shows */
    --ch: 10.6rem;
    --fw: min(100cqw, (100cqh - var(--ch) - 3.4rem) * 16 / 9);
    --fh: calc(var(--fw) * 9 / 16);
    --lift: 0px;
    position: relative;
    width: 100%;
    height: 100%;
    container-type: size;
    display: grid;
    align-content: center;
    justify-items: center;
  }

  :global([data-state='pv-sim']) .pv,
  :global([data-state='pv-plc']) .pv {
    --lift: calc(var(--ch) / -2 - 0.9rem);
  }

  .pv-frame {
    position: relative;
    width: var(--fw);
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-sunken);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--l-processview) 30%, var(--line));
    transform: translateY(var(--lift));
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .pv-layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur) var(--ease-out),
      visibility 0s linear var(--dur);
  }

  .pv-layer :global(.mlayer) {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    height: 100%;
  }

  :global([data-state='pv-build']) .l-build,
  :global([data-state='pv-selection']) .l-select,
  :global([data-state='pv-registers']) .l-reg,
  :global([data-state='pv-sim']) .l-sim,
  :global([data-state='pv-plc']) .l-plc {
    opacity: 1;
    visibility: visible;
    transition:
      opacity var(--dur) var(--ease-out),
      visibility 0s;
  }

  /* zoom: the still scales about a corner, the ring is drawn in frame coordinates */
  .zoom {
    position: absolute;
    inset: 0;
    transform-origin: 100% 0%;
    transition: transform 1.1s var(--ease-out);
  }

  .l-plc .zoom {
    transform-origin: 100% 50%;
  }

  :global([data-state='pv-selection']) .l-select .zoom,
  :global([data-state='pv-plc']) .l-plc .zoom {
    transform: scale(var(--s));
    transition-delay: 0.12s;
  }

  /* leaving, a zoomed still fades out as it is and resets only once it is hidden (no second zoom on the way out) */
  .st-look:not([data-on]) .zoom {
    transition: transform 0s linear var(--dur);
  }

  /* a thin outline in the layer's colour around what the step talks about */
  .ring,
  .callout {
    position: absolute;
    border-radius: 10px;
    box-shadow: 0 0 0 1.5px var(--l-processview);
    clip-path: inset(0 100% 100% 0 round 10px);
    transition: clip-path 0.7s var(--ease-out);
  }

  :global([data-state='pv-selection']) .ring {
    clip-path: inset(-30px round 10px);
    transition-delay: 0.8s;
  }

  .callout {
    top: 2%;
    right: 1%;
    bottom: 2%;
  }

  :global([data-state='pv-plc']) .callout {
    clip-path: inset(-60px -30px round 10px);
    transition-delay: 0.75s;
  }

  .plc-chip {
    position: absolute;
    top: 6%;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.4em 0.8em;
    border-radius: 999px;
    background: var(--bg-sunken);
    border: 1px solid color-mix(in srgb, var(--l-processview) 50%, var(--line));
    font: 600 0.74rem/1 var(--font-mono);
    color: var(--text);
    white-space: nowrap;
    opacity: 0;
    transform: translateX(8px);
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  :global([data-state='pv-plc']) .plc-chip {
    opacity: 1;
    transform: none;
    transition-delay: 1.1s;
  }

  .plc-chip i {
    width: 0.45em;
    height: 0.45em;
    border-radius: 50%;
    background: var(--ok);
  }

  /* registers: the same screen on three tabs, so one switches to the next like a tab: a short cross-fade at the same
     scale, no zoom */
  .reg {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.35s var(--ease-soft);
  }

  .l-reg[data-reg='0'] [data-reg-item='0'],
  .l-reg[data-reg='1'] [data-reg-item='1'],
  .l-reg[data-reg='2'] [data-reg-item='2'] {
    opacity: 1;
  }

  .pv-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 60px rgb(0 0 0 / 0.35);
    border-radius: inherit;
  }

  /* caption under the frame */
  .pv-caption {
    position: relative;
    width: var(--fw);
    height: 1.4em;
    margin: 0.75rem 0 0;
    font: 500 var(--fs-xs) / 1.4 var(--font-mono);
    color: var(--text-3);
    transform: translateY(var(--lift));
    transition: transform var(--dur-slow) var(--ease-out);
  }

  [data-cap] {
    position: absolute;
    left: 0;
    top: 0;
    padding-left: 1.1em;
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
    white-space: nowrap;
  }

  [data-cap]::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 0.4em;
    height: 0.4em;
    border-radius: 50%;
    background: var(--l-processview);
  }

  :global([data-state='pv-build']) [data-cap='pv-build'],
  :global([data-state='pv-selection']) [data-cap='pv-selection'],
  :global([data-state='pv-sim']) [data-cap='pv-sim'],
  :global([data-state='pv-plc']) [data-cap='pv-plc'],
  :global([data-state='pv-registers']) .pv:has(.l-reg[data-reg='0']) [data-cap-reg='0'],
  :global([data-state='pv-registers']) .pv:has(.l-reg[data-reg='1']) [data-cap-reg='1'],
  :global([data-state='pv-registers']) .pv:has(.l-reg[data-reg='2']) [data-cap-reg='2'] {
    opacity: 1;
  }

  /* the batch chart floats over the frame's lower left while the batch runs and after it */
  .pv-chart {
    position: absolute;
    left: calc(50% - var(--fw) / 2);
    top: calc(50% + var(--fh) / 2 + 2.6rem);
    width: var(--fw);
    opacity: 0;
    visibility: hidden;
    transform: translateY(calc(var(--lift) + 18px));
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur-slow) var(--ease-out),
      visibility 0s linear var(--dur);
  }

  :global([data-state='pv-sim']) .pv-chart,
  :global([data-state='pv-plc']) .pv-chart {
    opacity: 1;
    visibility: visible;
    transform: translateY(var(--lift));
    transition:
      opacity var(--dur) var(--ease-out) 0.15s,
      transform var(--dur-slow) var(--ease-out) 0.15s,
      visibility 0s;
  }

  @media (max-width: 760px) {
    .pv {
      --fw: 100cqw;
      --lift: 0px !important;
      align-content: start;
    }

    .pv-frame {
      border-radius: 10px;
    }

    .pv-caption {
      font-size: 0.66rem;
      margin-top: 0.4rem;
    }

    .pv-chart {
      left: 0;
      top: calc(var(--fh) + 2.1rem);
    }

    .plc-chip {
      top: auto;
      bottom: 8%;
      font-size: 0.6rem;
    }
  }
</style>
