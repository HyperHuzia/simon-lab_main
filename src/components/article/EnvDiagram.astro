---
// Chapter 1 stage, five states:
//   env-chat     a chat: three dialogs, a new chat each time; every answer prints a PDF that drifts off to the right
//                and fades into the void, so nothing carries over to the next question
//   env-agent    the same chat shrinks into the heart of an AI agent: a window closes round it and it gets its plan,
//                tools, files and checks round a loop
//   env-docs     the AI agent on a project without an environment: it fires series of documents like a machine gun,
//                row after row, then in diagonal bursts that collide (cracked documents, red crosses) until it jams
//   env-build    the Simon Lab environment: a row per layer, bottom-up, built revision by revision (CapacityIndex,
//                ProcessView, back down to CapacityIndex, ProcessView again)
//   env-release  the rest of the stack, a change in ProcessView rebuilding what depends on it, a check over every
//                document, and every row moving from beta to v1.0
// One SVG for shapes (viewBox 600 × 540) and HTML labels on top, positioned in the same coordinates (--u = one SVG
// unit), so text stays crisp at any size; the AI agent's own words are SVG text, so they travel with it. CSS places
// the groups for each state (the stage's data-state); the timelines are src/scripts/article/env.ts. The markup itself
// and static copies (no-JS figures) show each state's final picture.
import { LAYERS } from '../../data/article';

interface Props {
  labels: Record<string, string>;
  /** fixed state for static copies (no-JS figures) */
  state?: string;
}

const { labels, state } = Astro.props;
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
const at = (x: number, y: number) => `left:${pct(x, 600)};top:${pct(y, 540)}`;
const docPath = 'M-15 -20 h20 l10 10 v30 h-30 z M5 -20 v10 h10';
const tr = (x: number, y: number, r = 0, s = 1) => `transform:translate(${x}px,${y}px) rotate(${r}deg) scale(${s})`;

// ── env-chat: three dialogs in one window; each PDF prints under the answer and drifts off to the right
const DIALOGS = [1, 2, 3].map((n) => ({ q: labels[`chatQ${n}`], a: labels[`chatA${n}`], pdf: labels[`pdf${n}`] }));
const PRINT = { x: 112, y: 300 };
const DRIFT = [
  { x: 474, y: 150, r: 8, ghost: 0.1 },
  { x: 528, y: 284, r: -7, ghost: 0.13 },
  { x: 468, y: 414, r: 11, ghost: 0.17 },
];

// ── env-agent: the AI agent in its own coordinates (centre 0 0); CSS moves and scales it per state
const R = 118;
const STATIONS = [
  { id: 'plan', x: 0, y: -R, link: 'M0 -46V-100', label: labels.plan, ly: -26 },
  { id: 'use', x: R, y: 0, link: 'M60 0H100', label: labels.use, ly: 36 },
  { id: 'files', x: 0, y: R, link: 'M0 46V100', label: labels.files, ly: 36 },
  { id: 'check', x: -R, y: 0, link: 'M-60 0H-100', label: labels.check, ly: 36 },
];
const FRAME = 'M-156 -200H156A16 16 0 0 1 172 -184V168A16 16 0 0 1 156 184H-156A16 16 0 0 1 -172 168V-184A16 16 0 0 1 -156 -200Z';

// ── env-docs: three neat rows, then three diagonal bursts (seeded, so every build draws the same mess)
let seed = 7;
const rnd = () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
type Tile = { x: number; y: number; r: number; burst: number; crack?: boolean; cross?: boolean };
const TILES: Tile[] = [];
[120, 186, 252].forEach((y, b) => {
  for (let i = 0; i < 8; i++) TILES.push({ x: 214 + i * 46, y, r: 0, burst: b });
});
const BURSTS = [
  { from: [222, 344], to: [566, 132] },
  { from: [246, 130], to: [560, 452] },
  { from: [214, 456], to: [566, 316] },
];
BURSTS.forEach(({ from, to }, k) => {
  const angle = (Math.atan2(to[1] - from[1], to[0] - from[0]) * 180) / Math.PI;
  for (let i = 0; i < 8; i++) {
    const t = (i + 0.5) / 8;
    const x = from[0] + (to[0] - from[0]) * t + (rnd() - 0.5) * 20;
    const y = from[1] + (to[1] - from[1]) * t + (rnd() - 0.5) * 20;
    const hit = TILES.some((o) => Math.hypot(o.x - x, o.y - y) < 26);
    TILES.push({ x: +x.toFixed(1), y: +y.toFixed(1), r: +(angle * 0.6 + (rnd() - 0.5) * 24).toFixed(1), burst: 3 + k, crack: hit });
  }
});
// red crosses: documents that do not agree with the others, on tiles without a crack
TILES.filter((t) => !t.crack)
  .filter((_, i) => i % 5 === 3)
  .slice(0, 8)
  .forEach((t) => (t.cross = true));
const MUZZLE = { x: 156, y: 290 };

// ── env-build / env-release: a row of slots per layer, bottom-up; MechGraph and IonGrid share row 2
const ROW_Y = [470, 410, 350, 290, 230];
const SLOT = { x: 196, step: 56, w: 46, h: 32 };
const byLevel = (lv: number) => LAYERS.filter((l) => l.level === lv);
const ROWS = [1, 2, 3, 4, 5].map((lv, ri) => {
  const layers = byLevel(lv);
  const count = [3, 4, 4, 3, 3][ri];
  const apps = layers.length === 2 ? [layers[0], layers[0], layers[1], layers[1]] : Array(count).fill(layers[0]);
  return { y: ROW_Y[ri], name: layers.map((l) => l.name).join(' · '), apps: layers.map((l) => l.id), slots: apps.slice(0, count) as typeof layers };
});
const SLOTS = ROWS.flatMap((row, ri) => row.slots.map((l, k) => ({ ri, app: l.id, c: l.color, x: SLOT.x + k * SLOT.step, y: row.y - SLOT.h / 2 })));

// static copies (no-JS figures) carry only what their state shows
const VISIBLE: Record<string, string[]> = {
  'env-chat': ['chat'],
  'env-agent': ['agent'],
  'env-docs': ['agent', 'docs'],
  'env-build': ['agent', 'env'],
  'env-release': ['agent', 'env'],
};
const has = (part: string) => !state || (VISIBLE[state] ?? []).includes(part);
// the badges: the markup is the end of env-release (every row at v1.0); the static copy of env-build shows the first
// two rows at their last revision and the environment still in beta
const halfway = state === 'env-build';
const rev = (n: number) => (labels.rev ?? '{n}').replace('{n}', String(n));
const badge = (ri: number) => (halfway ? [rev(2), rev(3)][ri] : labels.release);
// the diagram's text alternative, in the page language (its parts are presentational under role="img")
const summary = [labels.chat, `${labels.aiAgent}: ${[labels.plan, labels.use, labels.files, labels.check].join(', ')}`, labels.environment].join(' → ');
---

<div class="env" data-env data-fixed-state={state} role="img" aria-label={summary}>
  <svg class="env-svg" viewBox="0 0 600 540" aria-hidden="true" focusable="false">
    {/* ── env-chat: the chat window ── */}
    {
      has('chat') && (
        <g class="g-chat">
          <g class="win">
            <rect class="win-box" x="40" y="60" width="290" height="410" rx="14" />
            <path class="win-bar" d="M40 94H330" />
            <circle class="win-dot" cx="58" cy="77" r="3" />
            <circle class="win-dot" cx="69" cy="77" r="3" />
            <circle class="win-dot" cx="80" cy="77" r="3" />
            <rect class="bubble me" data-chat="q" data-on x="128" y="112" width="186" height="56" rx="12" />
            <g class="typing" data-chat="typing">
              <circle cx="74" cy="208" r="3" />
              <circle cx="85" cy="208" r="3" />
              <circle cx="96" cy="208" r="3" />
            </g>
            <rect class="bubble" data-chat="a" data-on x="56" y="186" width="216" height="56" rx="12" />
          </g>
          {DIALOGS.map((d, k) => (
            <g class="pdf" data-pdf={k} data-x={DRIFT[k].x} data-y={DRIFT[k].y} data-r={DRIFT[k].r} data-ghost={DRIFT[k].ghost} style={`${tr(DRIFT[k].x, DRIFT[k].y, DRIFT[k].r)};opacity:${DRIFT[k].ghost}`}>
              <path class="doc" transform="scale(1.25)" d={docPath} />
              <rect class="pdf-tag" x="-17" y="4" width="22" height="11" rx="2" />
              <text class="pdf-tag-t" x="-6" y="12.6">
                PDF
              </text>
              <text class="pdf-name" y="44">
                {d.pdf}
              </text>
            </g>
          ))}
        </g>
      )
    }

    {/* ── env-docs: series of documents, then the collisions ── */}
    {
      has('docs') && (
        <g class="g-docs">
          {TILES.map((t, i) => (
            <g class="dt" data-dt={i} data-burst={t.burst} data-x={t.x} data-y={t.y} data-r={t.r} style={tr(t.x, t.y, t.r, 0.78)}>
              <path class="doc" d={docPath} />
              {t.crack && <path class="crack" data-crack={t.burst} data-on d="M-9 -21 L-2 -9 L-8 -2 L1 6 L-4 13 L3 21" />}
              {t.cross && (
                <g class="cross" data-cross data-on transform="translate(13 -17)">
                  <circle r="8" />
                  <path d="M-3.5 -3.5l7 7M3.5 -3.5l-7 7" />
                </g>
              )}
            </g>
          ))}
        </g>
      )
    }

    {/* ── env-build / env-release: the environment, its rows and slots ── */}
    {
      has('env') && (
        <g class="g-env">
          <rect class="env-frame" x="10" y="10" width="580" height="520" rx="22" />
          {ROWS.map((row, ri) => (
            <rect class="scan" data-scan={ri} x={SLOT.x - 8} y={row.y - SLOT.h / 2 - 6} width={row.slots.length * SLOT.step + 4} height={SLOT.h + 12} rx="8" />
          ))}
          {SLOTS.map((s, n) => (
            <g class="slot" data-slot={n} data-row={s.ri} data-app={s.app} data-filled data-ok style={`--lc:${s.c}`}>
              <rect class="slot-box" x={s.x} y={s.y} width={SLOT.w} height={SLOT.h} rx="5" />
              <g class="fly">
                <path class="slot-doc" transform={`translate(${s.x + SLOT.w / 2} ${s.y + SLOT.h / 2}) scale(.42)`} d={docPath} />
              </g>
              <path class="slot-ok" d={`M${s.x + SLOT.w - 11} ${s.y + 7}l3 3 6-6`} />
            </g>
          ))}
          <path class="sweep" data-sweep d="M160 500H560" />
        </g>
      )
    }

    {/* ── the AI agent: the chat at its heart, a window round it, plan, tools, files and checks on a loop ── */}
    {
      has('agent') && (
        <g class="g-agent" data-agent>
          <path class="ag-frame" data-build="frame" data-on d={FRAME} pathLength="1" />
          <path class="ag-bar" data-build="frame" data-on d="M-172 -164H172" />
          <text class="ag-text ag-title" y="-176">
            {labels.aiAgent}
          </text>
          <circle class="loop-path" data-build="loop" data-on r={R} />
          {[45, 135, 225, 315].map((deg) => (
            <path class="loop-tip" data-build="loop" data-on transform={`rotate(${deg})`} d={`M-4 ${-R - 4}l5 4-5 4`} />
          ))}
          {STATIONS.map((st) => (
            <path class="link" data-build={st.id} data-on d={st.link} />
          ))}
          <g class="marker" data-marker>
            <circle cy={-R} r="5" />
          </g>
          <g class="core">
            <rect class="core-glow" x="-66" y="-52" width="132" height="104" rx="13" />
            <rect class="core-box" x="-58" y="-44" width="116" height="88" rx="9" />
            <path class="core-bar" d="M-58 -28H58" />
            <circle class="win-dot" cx="-46" cy="-36" r="2.4" />
            <circle class="win-dot" cx="-37" cy="-36" r="2.4" />
            <circle class="win-dot" cx="-28" cy="-36" r="2.4" />
            <path class="agent-star" transform="translate(0 9) scale(1.1)" d="M0 -15 C1.6 -4 4 -1.6 15 0 C4 1.6 1.6 4 0 15 C-1.6 4 -4 1.6 -15 0 C-4 -1.6 -1.6 -4 0 -15 Z" />
          </g>
          {STATIONS.map((st) => (
            <g class="station" data-build={st.id} data-station={st.id} data-on transform={`translate(${st.x} ${st.y})`}>
              <circle class="st-hot" r="24" />
              <circle class="st-box" r="17" />
              {st.id === 'plan' && <path class="st-ico" d="M-7 -5h14M-7 0h14M-7 5h8" />}
              {st.id === 'use' && <path class="st-ico" d="M-6 6L2.4 -2.4M3 -7.8a4.8 4.8 0 1 0 4.8 4.8l-3.1 .5-2.2-2.2z" />}
              {st.id === 'files' && <path class="st-ico" d="M-6 -8.5h8.5l5 5v12h-13.5z" />}
              {st.id === 'check' && <path class="st-ico st-ok" data-check data-on d="M-6.5 .5l4 4 8.5-9.5" />}
              <text class="ag-text ag-station" y={st.ly}>
                {st.label}
              </text>
            </g>
          ))}
          <g class="files">
            <path class="doc doc-sm" data-file data-on transform={`translate(28 ${R + 6}) scale(.5)`} d={docPath} />
            <path class="doc doc-sm" data-file data-on transform={`translate(44 ${R - 2}) scale(.5)`} d={docPath} />
          </g>
        </g>
      )
    }
  </svg>

  {/* labels: positioned in SVG units */}
  {
    has('chat') && (
      <>
        <span class="lbl l-win" data-title="first" style={at(185, 70)}>
          {labels.chat}
        </span>
        <span class="lbl l-win" data-title="new" data-on style={at(185, 70)}>
          {labels.newChat}
        </span>
        {DIALOGS.map((d, k) => (
          <span class="lbl l-bubble l-q" data-chat="q" data-dialog={k} data-on={k === 2 ? '' : undefined} style={at(140, 121)}>
            {d.q}
          </span>
        ))}
        {DIALOGS.map((d, k) => (
          <span class="lbl l-bubble l-a" data-chat="a" data-dialog={k} data-on={k === 2 ? '' : undefined} style={at(68, 195)}>
            {d.a}
          </span>
        ))}
      </>
    )
  }
  {
    has('docs') && (
      <span class="lbl l-agent-side" style={at(82, 390)}>
        {labels.aiAgent}
      </span>
    )
  }
  {
    has('env') && (
      <>
        <span class="lbl l-env" style={at(34, 30)}>
          {labels.environment}
        </span>
        <span class="lbl l-tag" data-tag data-word={labels.beta} data-done={labels.release} data-ok={halfway ? undefined : ''} style={at(566, 28)}>
          {halfway ? labels.beta : labels.release}
        </span>
        <span class="lbl l-agent-top" style={at(300, 140)}>
          {labels.agent}
        </span>
        {ROWS.map((row) => (
          <span class="lbl l-row" style={`${at(184, row.y - 8)};--lc:${row.slots[0].color}`}>
            {row.name}
          </span>
        ))}
        {ROWS.map((row, ri) => (
          <span class="lbl l-ver" data-ver={ri} data-apps={row.apps.join(' ')} data-word={labels.rev} data-done={labels.release} data-ok={halfway ? undefined : ''} data-on style={at(420, row.y - 9)}>
            {badge(ri)}
          </span>
        ))}
      </>
    )
  }
</div>

<style>
  .env {
    --u: calc(100cqw / 600);
    position: relative;
    container-type: inline-size;
    width: min(100%, 100cqh * 600 / 540);
    aspect-ratio: 600 / 540;
    margin: auto;
  }

  .env-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* ── the groups of each state ───────────────────────────── */
  .g-chat,
  .g-agent,
  .g-docs,
  .g-env {
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
  }

  :global([data-state='env-chat']) .g-chat,
  .env[data-fixed-state='env-chat'] .g-chat,
  :global([data-state='env-docs']) .g-docs,
  .env[data-fixed-state='env-docs'] .g-docs,
  :global(:is([data-state='env-build'], [data-state='env-release'])) .g-env,
  .env:is([data-fixed-state='env-build'], [data-fixed-state='env-release']) .g-env {
    opacity: 1;
    transition-delay: 0.15s;
  }

  /* the chat shrinks into the heart of the AI agent: the window flies to the agent's core and fades as the core
     appears there */
  .g-chat {
    transform: none;
    transition:
      opacity 0.5s var(--ease-out) 0.25s,
      transform 0.8s var(--ease-out);
  }

  :global(:is([data-state='env-agent'], [data-state='env-docs'], [data-state='env-build'], [data-state='env-release'])) .g-chat {
    transform: translate(300px, 290px) scale(0.38) translate(-185px, -265px);
  }

  /* the AI agent: whole in the middle, small on the left while it fires, small at the top of the environment */
  .g-agent {
    transform: translate(300px, 290px) scale(0.5);
    transition:
      opacity 0.6s var(--ease-out) 0.3s,
      transform var(--dur-slow) var(--ease-out);
  }

  :global([data-state='env-agent']) .g-agent,
  .env[data-fixed-state='env-agent'] .g-agent {
    opacity: 1;
    transform: translate(300px, 290px);
  }

  :global([data-state='env-docs']) .g-agent,
  .env[data-fixed-state='env-docs'] .g-agent {
    opacity: 1;
    transform: translate(82px, 290px) scale(0.42);
  }

  :global(:is([data-state='env-build'], [data-state='env-release'])) .g-agent,
  .env:is([data-fixed-state='env-build'], [data-fixed-state='env-release']) .g-agent {
    opacity: 1;
    transform: translate(300px, 76px) scale(0.3);
  }

  /* its own words only while it is large */
  .ag-text {
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
  }

  :global([data-state='env-agent']) .ag-text,
  .env[data-fixed-state='env-agent'] .ag-text {
    opacity: 1;
  }

  /* ── shapes ─────────────────────────────────────────────── */
  .win-box,
  .core-box {
    fill: var(--bg-raised);
    stroke: var(--line-strong);
    stroke-width: 1.2;
  }

  .win-bar,
  .core-bar,
  .ag-bar {
    stroke: var(--line);
    stroke-width: 1.2;
  }

  .win-dot {
    fill: var(--text-4);
  }

  .bubble {
    fill: var(--bg);
    stroke: var(--line-strong);
    stroke-width: 1.2;
  }

  .bubble.me {
    fill: color-mix(in srgb, var(--accent) 10%, var(--bg-raised));
    stroke: color-mix(in srgb, var(--accent) 40%, var(--line-strong));
  }

  .typing circle {
    fill: var(--text-3);
  }

  .doc {
    fill: var(--bg);
    stroke: var(--text-3);
    stroke-width: 1.3;
    stroke-linejoin: round;
  }

  .pdf-tag {
    fill: color-mix(in srgb, var(--alert) 70%, var(--bg));
  }

  .pdf-tag-t {
    font: 700 7px var(--font-mono);
    fill: var(--bg);
    text-anchor: middle;
  }

  .pdf-name {
    font: 600 10.5px var(--font-mono);
    fill: var(--text-3);
    text-anchor: middle;
  }

  /* the AI agent */
  .ag-frame {
    fill: rgb(17 21 31 / 0.55);
    stroke: color-mix(in srgb, var(--accent) 55%, var(--line-strong));
    stroke-width: 1.4;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition:
      stroke-dashoffset 0.6s var(--ease-out),
      stroke 0.4s var(--ease-out);
  }

  .ag-frame[data-on] {
    stroke-dashoffset: 0;
  }

  .ag-title {
    font: 600 11px var(--font-display);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill: var(--text-3);
    text-anchor: middle;
  }

  .ag-station {
    font: 600 12.5px var(--font-display);
    fill: var(--text-2);
    text-anchor: middle;
  }

  .core-glow {
    fill: none;
    stroke: var(--accent);
    stroke-opacity: 0.35;
    stroke-width: 1;
  }

  .agent-star {
    fill: var(--accent);
  }

  .loop-path {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.4;
  }

  .loop-tip {
    fill: none;
    stroke: var(--text-3);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .link {
    stroke: var(--line-strong);
    stroke-width: 1.2;
    stroke-dasharray: 3 4;
  }

  .st-box {
    fill: var(--bg);
    stroke: var(--line-strong);
    stroke-width: 1.2;
  }

  .st-hot {
    fill: color-mix(in srgb, var(--accent) 22%, transparent);
    opacity: 0;
  }

  .st-ico {
    fill: none;
    stroke: var(--text-2);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .st-ok {
    stroke: var(--text-4);
    transition: stroke var(--dur) var(--ease-out);
  }

  .st-ok[data-on] {
    stroke: var(--ok);
  }

  .doc-sm {
    stroke: var(--l-processview);
  }

  .marker {
    fill: var(--accent);
    transform-box: view-box;
    transform-origin: 0 0;
  }

  /* the build-up: frame, links and stations appear as the timeline switches them on */
  .g-agent [data-build]:not(.ag-frame) {
    opacity: 0;
    transition: opacity 0.35s var(--ease-out);
  }

  .g-agent [data-build][data-on]:not(.ag-frame) {
    opacity: 1;
  }

  /* jammed by its own documents: the frame turns to the alert, the loop stops */
  .g-agent[data-jam] .ag-frame {
    stroke: color-mix(in srgb, var(--alert) 70%, var(--line-strong));
  }

  .g-agent[data-jam] .marker {
    opacity: 0;
  }

  .g-agent[data-jam] .core {
    opacity: 0.55;
  }

  .core {
    transition: opacity var(--dur) var(--ease-out);
  }

  /* the machine gun's documents */
  .dt .doc {
    stroke: var(--text-2);
  }

  .crack {
    fill: none;
    stroke: var(--alert);
    stroke-width: 2.2;
