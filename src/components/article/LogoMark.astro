---
// The SL monogram (flask, L, molecule, bubbles) cut from public/brand/logo-neon.svg with its path ids. It is the
// logo, so it keeps the logo's gradient: userSpaceOnUse over the 300 × 109.5 lockup, so the mark carries exactly the
// colours it has in the logo. It stands still (no rising bubbles).
interface Props {
  /** unique suffix for the gradient id (several marks per page) */
  uid: string;
  class?: string;
}

const { uid, class: className } = Astro.props;
const fill = `url(#sl-grad-${uid})`;
