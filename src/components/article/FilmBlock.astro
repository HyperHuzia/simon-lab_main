---
// Closing block: the film (poster + play button, click-to-load, no autoplay; EN film for EN and DE pages, PL film for
// PL, caption tracks en/pl/de with the German track on by default on DE pages), then the beta and apps CTAs.
import type { Article } from '../../content/bottom-up/types';
import { BLANK_SRC, film } from '../../data/media';
import { path, type Lang } from '../../i18n/config';
import FilmVideo from '../FilmVideo.astro';
import MediaLayer from './MediaLayer.astro';

interface Props {
  closing: Article['closing'];
  lang: Lang;
}

const { closing, lang } = Astro.props;
const filmId = lang === 'pl' ? 'film-pl' : 'film-en';
const f = film(filmId);
const srcset = (list: { w: number; src: string }[]) => list.map((s) => `${s.src} ${s.w}w`).join(', ');
const posterSrc = f?.poster ? [...f.poster.webp].sort((a, b) => a.w - b.w).find((s) => s.w >= 1280) ?? f.poster.webp[f.poster.webp.length - 1] : undefined;
// meta chips under the frame: duration, narration language, caption languages
const duration = f?.duration ? `${Math.floor(f.duration / 60)}:${String(Math.round(f.duration % 60)).padStart(2, '0')}` : undefined;
const narration = (f?.lang ?? (filmId === 'film-pl' ? 'pl' : 'en')).toUpperCase();
const captionLangs = f?.tracks.map((t) => t.lang.toUpperCase()).join(' · ');
---

<section class="closing" id="film" data-chapter="film">
  <div class="film">
    <p class="film-eyebrow">{closing.filmTitle}</p>
    <div class="film-frame" data-film style={f ? `aspect-ratio:${f.width} / ${f.height}` : undefined}>
      {
        f?.poster ? (
          <div class="film-poster" data-media={`${filmId}-poster`} style={f.poster.bg ? `--ph:${f.poster.bg}` : undefined}>
            <picture>
              <source type="image/avif" data-srcset={srcset(f.poster.avif)} sizes="(min-width: 1240px) 1200px, 100vw" />
              <source type="image/webp" data-srcset={srcset(f.poster.webp)} sizes="(min-width: 1240px) 1200px, 100vw" />
              <img src={BLANK_SRC} data-src={posterSrc?.src} data-srcset={srcset(f.poster.webp)} sizes="(min-width: 1240px) 1200px, 100vw" alt="" width={f.poster.width} height={f.poster.height} decoding="async" />
            </picture>
          </div>
        ) : (
          <MediaLayer id={filmId} lang={lang} kind="clip" />
        )
      }
      <button class="film-play" type="button" data-film-play aria-describedby={`${filmId}-desc`} disabled={!f}>
        <span class="film-play-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5.2v13.6L19 12z" fill="currentColor"></path></svg></span>
        <span>{closing.play}</span>
      </button>
      <FilmVideo lang={lang} />
    </div>
    <div class="film-meta">
      <p class="film-caption" id={`${filmId}-desc`}>{closing.filmCaption}</p>
      <p class="film-chips" aria-hidden="true">
        {duration && <span>{duration}</span>}
        <span>{narration}</span>
        {captionLangs && <span><b>CC</b> {captionLangs}</span>}
      </p>
    </div>
  </div>

  <div class="closing-copy">
    <p class="closing-eyebrow">{closing.eyebrow}</p>
    <h2 class="closing-title">{closing.title}</h2>
    {closing.body.map((p) => <p class="closing-body" set:html={p} />)}
    <div class="closing-ctas">
      <a class="btn btn-solid" href={path('/beta/', lang)}>{closing.cta.beta}</a>
      <a class="btn btn-primary" href={path('/apps/', lang)}>{closing.cta.apps}</a>
    </div>
  </div>
</section>

<style>
  .closing {
    position: relative;
    padding: clamp(6rem, 4rem + 8vh, 10rem) 0 clamp(3rem, 2rem + 4vh, 5rem);
  }

  .film,
  .closing-copy {
    width: min(100% - 2 * var(--gutter), 76rem);
    margin-inline: auto;
  }

  .film-eyebrow,
  .closing-eyebrow {
    margin: 0 0 1.1rem;
    font: 600 0.78rem / 1.4 var(--font-display);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--accent) 83%, white);
  }

  /* the film keeps its own colours; the frame around it is a hairline */
  .film-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-sunken);
    box-shadow: 0 0 0 1px var(--line-strong);
  }

  .film-frame :global(.mlayer),
  .film-poster {
    position: absolute;
    inset: 0;
    height: 100%;
    aspect-ratio: auto;
    background: var(--ph, #0e1220);
  }

  .film-poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur) var(--ease-soft);
  }

  .film-poster[data-ready] img {
    opacity: 1;
  }

  .film-frame :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: #000;
  }

  /* bottom-left, clear of the poster's centred lockup */
  .film-play {
    position: absolute;
    left: clamp(0.75rem, 2.5%, 1.75rem);
    bottom: clamp(0.75rem, 3.5%, 1.75rem);
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.6rem 1.3rem 0.6rem 0.6rem;
    border: 1px solid rgb(238 241 246 / 0.22);
    border-radius: 999px;
    background: rgb(11 14 23 / 0.82);
    color: var(--text);
    font: 600 var(--fs-base) / 1 var(--font-display);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .film-play:hover:not(:disabled) {
    border-color: rgb(238 241 246 / 0.55);
    background: rgb(11 14 23 / 0.92);
  }

  .film-play:disabled {
    cursor: default;
    opacity: 0.55;
  }

  /* light on dark, like the solid button */
  .film-play-ico {
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    background: var(--text);
    color: var(--bg);
  }

  .film-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem 1.5rem;
    margin-top: 0.9rem;
  }

  .film-caption {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--text-3);
  }

  .film-chips {
    display: flex;
    gap: 0.4rem;
    margin: 0;
  }

  .film-chips span {
    padding: 0.25em 0.65em;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font: 600 0.7rem / 1.3 var(--font-display);
    letter-spacing: 0.08em;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }

  .film-chips b {
    color: var(--text);
    font-weight: 700;
  }

  .closing-copy {
    padding-top: clamp(4rem, 3rem + 5vh, 7rem);
  }

  .closing-copy > * {
    max-width: 44rem;
  }

  .closing-title {
    font-size: clamp(1.9rem, 1.3rem + 1.9vw, 3rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin-bottom: 1.4rem;
  }

  .closing-body {
    font-size: var(--fs-lg);
    line-height: 1.6;
    color: var(--text-2);
  }

  .closing-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .closing-ctas .btn {
    padding: 0.9em 1.4em;
  }

  @media (max-width: 760px) {
    .film-frame {
      border-radius: 10px;
    }

    .closing-title {
      font-size: clamp(1.55rem, 1.1rem + 2.4vw, 1.9rem);
    }

    .film-play {
      font-size: var(--fs-sm);
      padding: 0.5rem 1rem 0.5rem 0.5rem;
    }

    .film-play-ico {
      width: 2.3rem;
      height: 2.3rem;
    }
  }
</style>
