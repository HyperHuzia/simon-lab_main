---
// One Lucide icon, inlined (the set lives in ./icons.ts). Decorative by default (aria-hidden); pass `label` when the
// icon carries meaning on its own.
import { ICONS, type IconName } from './icons';

interface Props {
  name: IconName;
  /** rendered width and height in px (the drawing is 24×24) */
  size?: number;
  /** stroke width in drawing units; Lucide's default is 2, the site uses a lighter 1.6 */
  stroke?: number;
  class?: string;
  /** accessible name; without it the icon is hidden from assistive technology */
  label?: string;
}

const { name, size = 18, stroke = 1.6, class: className, label } = Astro.props;
// the drawing without the outer <svg> and the licence comment
const inner = ICONS[name].replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').trim();
---

<svg
  class:list={['icon', className]}
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={inner}
/>
