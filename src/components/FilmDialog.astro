---
// The film in a window over the page, opened by any [data-film-open] link (the homepage's hero drawing and the link
// under it, the Bottom-up article's "Watch the film"). A native <dialog> with nothing but the film: 16:9, as large as
// the screen allows without scrolling, a close button in its corner; Esc or a click beside the film closes it, the
// film pauses and the focus goes back to the link. The video loads only when the window first opens (FilmVideo's
// template). Without JavaScript, or where <dialog> is missing, the links lead to the film at the end of the article.
// Behaviour: initFilmDialog in src/scripts/article/film.ts.
import type { Lang } from '../i18n/config';
import { t } from '../i18n/ui';
import FilmVideo from './FilmVideo.astro';

interface Props {
  lang: Lang;
  /** the window's accessible name */
  title: string;
}

const { lang, title } = Astro.props;
const ui = t(lang);
---

<dialog class="film-dialog" data-film-dialog aria-label={title}>
  <div class="fd-frame" data-film-frame></div>
  <button type="button" class="fd-close" data-film-close aria-label={ui('film.close')}>
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
    </svg>
  </button>
  <FilmVideo lang={lang} />
</dialog>

<style>
  /* the film fills the window: 16:9, never taller than the screen, so nothing scrolls */
  .film-dialog {
    width: min(92vw, calc((100svh - 4rem) * 16 / 9));
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: #000;
    overflow: visible;
  }

  .film-dialog::backdrop {
    background: rgb(5 7 12 / 0.88);
  }

  .fd-frame {
    aspect-ratio: 16 / 9;
    border-radius: inherit;
    overflow: hidden;
    background: #000;
  }

  .fd-frame :global(video) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .fd-close {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid rgb(238 241 246 / 0.3);
    border-radius: 50%;
    background: rgb(11 14 23 / 0.72);
    color: var(--text);
    cursor: pointer;
  }

  .fd-close:hover {
    border-color: rgb(238 241 246 / 0.6);
  }

  .fd-close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
