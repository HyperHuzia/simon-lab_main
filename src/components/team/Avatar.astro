---
// Drawn portraits for the team members without a photo: line art in the site's style, one accent colour each, no
// logos. Decorative (the name sits next to it); it fills its frame, which draws the ring.
import type { DrawnId } from '../../content/team/types';

interface Props {
  who: DrawnId;
}

const { who } = Astro.props;
const ACCENT: Record<DrawnId, string> = {
  opus: 'var(--l-architecture)',
  astra: 'var(--l-capacity)',
  grok: 'var(--warn)',
};
---

<svg class="avatar" viewBox="0 0 120 120" width="96" height="96" aria-hidden="true" style={`--a:${ACCENT[who]}`}>
  <circle class="bg" cx="60" cy="60" r="58"></circle>
  {
    who === 'opus' && (
      <g>
        {/* the people person: a big smile, a headset, a speech bubble that is never empty */}
        <circle class="face" cx="60" cy="66" r="27" />
        <path d="M47 62q4-5 8 0M65 62q4-5 8 0" />
        <path d="M48 74q12 11 24 0" />
        <path class="a" d="M29 68a31 31 0 0 1 62 0" />
        <rect class="a" x="24" y="62" width="8" height="15" rx="3" />
        <rect class="a" x="88" y="62" width="8" height="15" rx="3" />
        <path class="a" d="M28 77q1 13 17 13" />
        <circle class="a-fill" cx="46" cy="90" r="2.6" />
        <path class="a" d="M82 14h24a6 6 0 0 1 6 6v11a6 6 0 0 1-6 6h-13l-7 7v-7h-4a6 6 0 0 1-6-6V20a6 6 0 0 1 6-6z" />
        <circle class="a-fill" cx="87" cy="25.5" r="1.7" />
        <circle class="a-fill" cx="94" cy="25.5" r="1.7" />
        <circle class="a-fill" cx="101" cy="25.5" r="1.7" />
      </g>
    )
  }
  {
    who === 'astra' && (
      <g>
        {/* the standard keeper: square, symmetric, a level on top and a ruler for a mouth */}
        <rect class="face" x="34" y="38" width="52" height="50" rx="5" />
        <rect x="44" y="54" width="8" height="8" />
        <rect x="68" y="54" width="8" height="8" />
        <path d="M45 75h30M48 75v-3M54 75v-2M60 75v-4M66 75v-2M72 75v-3" />
        <path class="a" d="M60 38V29" />
        <rect class="a" x="46" y="19" width="28" height="10" rx="5" />
        <circle class="a-fill" cx="60" cy="24" r="2.2" />
        <path class="faint" d="M24 44h5M24 52h3M24 60h5M24 68h3M24 76h5M24 84h3M91 44h5M93 52h3M91 60h5M93 68h3M91 76h5M93 84h3" />
      </g>
    )
  }
  {
    who === 'grok' && (
      <g>
        {/* the tireless one: hard hat on, content and slightly sleepy, coffee within reach */}
        <circle class="face" cx="54" cy="68" r="25" />
        <path class="a a-soft" d="M30 61a24 21 0 0 1 48 0z" />
        <path class="a" d="M25 61h58M54 40v-3" />
        <path d="M43 70h8M58 70h8" />
        <path d="M48 79q6 4 12 0" />
        <rect class="a" x="78" y="76" width="16" height="18" rx="2.5" />
        <path class="a" d="M94 80a5 5 0 0 1 0 10" />
        <path class="faint" d="M82 71q-3-4 0-8M88 71q-3-4 0-8" />
      </g>
    )
  }
</svg>

<style>
  .avatar {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--text-2);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .bg {
    fill: var(--bg);
    stroke: none;
  }

  .face {
    fill: var(--bg-raised);
  }

  .a {
    stroke: color-mix(in oklab, var(--a) 83%, white);
  }

  .a-soft {
    fill: color-mix(in oklab, var(--a) 22%, transparent);
  }

  .a-fill {
    fill: color-mix(in oklab, var(--a) 83%, white);
    stroke: none;
  }

  .faint {
    stroke: var(--text-3);
    stroke-width: 1.5;
  }
</style>
