---
import Base from '../layouts/Base.astro';
import MailtoButton from '../components/MailtoButton.astro';
import Icon from '../components/Icon.astro';
import { offers, offerUI } from '../content/services/offers';
import { servicesFor } from '../data/services';
import { path, type Lang } from '../i18n/config';
import { serviceRoute, type ServiceId } from '../i18n/service-routes';
import { ogImage } from '../data/media';
import '../styles/home.css';
import '../styles/services.css';

interface Props { lang: Lang; service: ServiceId }
const { lang, service } = Astro.props;
const offer = offers[lang].find((item) => item.id === service)!;
const ui = offerUI[lang];
const copy = servicesFor(lang);
const route = serviceRoute(service);
const body = [offer.title, '', ui.emailFields[1], '', ...offer.inputs.flatMap((field) => [`${field}:`, ''])].join('\n');
const site = import.meta.env.SITE ?? 'https://simon-lab.org';
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Service', name: offer.title, description: offer.summary,
  url: new URL(path(route, lang), site).href,
  provider: { '@type': 'Organization', '@id': `${site}/#organization`, name: 'Simon Lab', url: site },
};
---
<Base lang={lang} route={route} title={`${offer.title} | Simon Lab`} description={offer.summary} ogImage={ogImage('default')} jsonLd={jsonLd}>
  <section class="hp-sec service-hero" aria-labelledby="service-title">
    <a class="hp-more service-back" href={path('/services/', lang)}><Icon name="arrow-left" size={15} />{ui.back}</a>
    <p class="hp-eyebrow">{ui.eyebrow}</p>
    <h1 class="hp-title" id="service-title">{offer.title}</h1>
    <p class="hp-lede">{offer.summary}</p>
    <MailtoButton label={ui.contact} subject={offer.subject} body={body} />
    <p class="service-hint">{ui.emailHint}</p>
  </section>
  <section class="hp-sec service-facts" aria-label={ui.details}>
    {[{ title: ui.scope, items: offer.scope }, { title: ui.inputs, items: offer.inputs }, { title: ui.deliverables, items: offer.deliverables }].map((block) => (
      <section class="service-fact"><h2>{block.title}</h2><ul>{block.items.map((item) => <li>{item}</li>)}</ul></section>
    ))}
  </section>
  <section class="hp-sec service-quality" aria-labelledby="service-quality-title">
    <p class="hp-eyebrow">{ui.quality}</p>
    <h2 class="hp-title" id="service-quality-title">{copy.checked.title}</h2>
    {copy.checked.body.map((paragraph) => <p class="hp-lede">{paragraph}</p>)}
  </section>
  <section class="hp-sec service-order" id="zapytanie" aria-labelledby="service-order-title">
    <h2 class="hp-title" id="service-order-title">{ui.contact}</h2>
    <p class="hp-lede">{ui.contactBody}</p>
    <MailtoButton label={ui.contact} subject={offer.subject} body={body} />
    <p class="service-hint">{ui.emailHint}</p>
  </section>
  <section class="hp-sec service-related" aria-label={ui.back}>
    {offers[lang].filter((item) => item.id !== service).map((item) => <a class="hp-more" href={path(serviceRoute(item.id), lang)}>{item.title}<Icon name="arrow-right" size={15} /></a>)}
  </section>
</Base>
